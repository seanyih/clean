set_option autoImplicit false

-- helper for printf `%x` / `%X` (main-spec §8.1)
def hexOf (n : Nat) : String := String.ofList (Nat.toDigits 16 n)

-- c: sprintf.c:8
-- `sprintf` / `snprintf` (main-spec §8.1 format table): the same formats as
-- `printf`, but the text goes into a string variable instead of the console:
-- `buf := s!"…"`. It is not I/O, so a function that only builds strings stays
-- pure. `snprintf(buf, n, …)` keeps at most n-1 characters.
def scratch (n : Int) : Int := Id.run do
  let mut buf : String := ""
  buf := s!"{n}"
  return n + 1

-- c: sprintf.c:14
def main : IO UInt32 := do
  let mut buf : String := ""
  buf := s!"n={(255 : Int)} hex={hexOf 255} ch={'q'} s=str\n"
  IO.print s!"{buf}"
  let mut small : String := ""
  small := ((s!"abcdefgh{(12 : Int)}").take (5 - 1)).toString
  IO.println s!"[{small}]"
  let k : Int := 4
  small := ((s!"{(1 : Int)}-{(2 : Int)}-{scratch k}").take (((k + 4).toNat) - 1)).toString
  IO.println s!"[{small}]"
  return 0
