-- helper for fgetc/getc: one byte as an int, -1 at the end of the input (main-spec §8.1)
def fgetc (f : IO.FS.Stream) : IO Int := do
  let b ← f.read 1
  return if b.isEmpty then -1 else Int.ofNat b[0]!.toNat

-- helper for getchar
def getchar : IO Int := do
  fgetc (← IO.getStdin)

-- helper for fgets: a line of at most n-1 bytes, newline kept; `old` stays when nothing was read
def fgets (f : IO.FS.Stream) (n : Nat) (old : String) : IO String := do
  let mut bytes := ByteArray.empty
  let mut room := n - 1
  while room > 0 do
    let b ← f.read 1
    if b.isEmpty then break
    bytes := bytes.push b[0]!
    room := room - 1
    if b[0]! == 10 then break
  if bytes.isEmpty then return old
  return (String.fromUTF8? bytes).getD ""

-- c: input_lines.c:8
-- `fgets` and `getchar` (main-spec §8.1): lines and single characters from
-- standard input. `fgets(s, n, f)` reads at most n-1 characters of one line,
-- the newline included, into the string `s`; at the end of the input `s` is
-- left as it was (C returns NULL there). `getchar()` is an int: -1 (EOF) at the end.
def report (c : Int) : IO Unit := do
  if c = (-1) then
    IO.println "eof"
  else
    IO.println s!"char {Char.ofNat c.toNat} ({c})"

