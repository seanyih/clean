set_option autoImplicit false

-- helper for strcmp: the sign of the comparison, as C's `int` (main-spec §12.3)
def strcmp (a b : String) : Int :=
  match compare a b with
  | .lt => -1
  | .eq => 0
  | .gt => 1

-- helper for fgets: a line of at most n-1 bytes, newline kept; `old` stays when nothing was read
def fgets (f : IO.FS.Stream) (n : Nat) (old : String) : IO String := do
  let mut bytes := ByteArray.empty
  let mut room := n - 1
  while room > 0 do
    let b ← f.read 1
    if b.isEmpty then break
    bytes := bytes.push b[0]!
    room := room - 1
    if b[0]! == 10 then break
  if bytes.isEmpty then return old
  return (String.fromUTF8? bytes).getD ""

-- c: flush_strcpy.c:6
-- `fflush(f)` is `f.flush` (like `fclose`), and `strcpy(dst, src);` is the
-- statement `dst := src` (manual gaps G25 and the `line = ""` workaround).
def main : IO UInt32 := do
  let mut line : String := "unchanged"
  let mut count : Nat := 0
  (← IO.getStdout).putStr "Lines? "
  (← IO.getStdout).flush
  line := ""
  line ← fgets (← IO.getStdin) 64 line
  while strcmp line "" ≠ 0 do
    count := count + 1
    line := ""
    line ← fgets (← IO.getStdin) 64 line
    pure ()
  IO.println s!"{count}"
  return 0
