def main : IO UInt32 := do
  let f : IO.FS.Stream := (← fopen "squares.txt" "w")
  write_squares f 5
  f.flush
  IO.println s!"total={(← sum_file "squares.txt" 5)}"
  let mut tries : Int := 0
  repeat
    tries := tries + 1
    IO.println s!"try {tries}"
    unless tries < 3 do
