-- helper for fgetc/getc: one byte as an int, -1 at the end of the input (main-spec §8.1)
def fgetc (f : IO.FS.Stream) : IO Int := do
  let b ← f.read 1
  return if b.isEmpty then -1 else Int.ofNat b[0]!.toNat

-- helper for getchar
def getchar : IO Int := do
  fgetc (← IO.getStdin)

-- helper for fopen: "r" reads, "w" writes (truncating), "a" appends; a failure is an IO error
def fopen (path mode : String) : IO IO.FS.Stream := do
  let m := if mode.startsWith "w" then IO.FS.Mode.write
    else if mode.startsWith "a" then IO.FS.Mode.append else IO.FS.Mode.read
  return IO.FS.Stream.ofHandle (← IO.FS.Handle.mk path m)

-- helper for scanf: the next whitespace-separated word, none at the end of the input
def scanWord (f : IO.FS.Stream) : IO (Option String) := do
  let mut bytes := ByteArray.empty
  repeat
    let b ← f.read 1
    if b.isEmpty then break
    let c := b[0]!
    if c == 32 || (c >= 9 && c <= 13) then
      if bytes.isEmpty then continue
      break
    bytes := bytes.push c
  if bytes.isEmpty then return none
  return some ((String.fromUTF8? bytes).getD "")

-- helpers for scanf: read a word into a variable; the variable keeps its value when there is nothing to read
def scanInt (f : IO.FS.Stream) (old : Int) : IO Int := do
  return ((← scanWord f).bind String.toInt?).getD old

-- c: input_loops.c:7
-- Loops and I/O together (main-spec §6, §8): write and read a file in `for`
-- loops, and read standard input character by character until EOF. A loop
-- that reads or prints makes its function `IO`; the loop itself is unchanged.
def write_squares (f : IO.FS.Stream) (n : Int) : IO Unit := do
  let mut i : Int := 1
  while i <= n do
    f.putStrLn s!"{i * i}"
    i := i + 1

-- c: input_loops.c:13
def sum_file (path : String) (n : Int) : IO Int := do
  let g : IO.FS.Stream := (← fopen path "r")
  let mut total : Int := 0
  let mut v : Int := 0
  let mut k : Int := 0
  while k < n do
    v ← scanInt g v
    total := total + v
    k := k + 1
  g.flush
  return total

-- c: input_loops.c:27
-- the C idiom `while ((c = getchar()) != EOF)` is an assignment inside a
-- condition (E103), so the read is written out
def count_input : IO Unit := do
  let mut lines : Int := 0
  let mut others : Int := 0
  let mut c : Int := (← getchar)
  while c ≠ (-1) do
    if c = (↑'\n'.toNat : Int) then
      lines := lines + 1
    else if c = (↑' '.toNat : Int) then
      c := (← getchar)
      continue
    else
      others := others + 1
    c := (← getchar)
  IO.println s!"lines={lines} others={others}"

