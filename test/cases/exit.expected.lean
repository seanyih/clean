-- c: exit.c:8
-- `exit(n)` → `IO.Process.exit` (main-spec §8.1). It ends the program, so like
-- `return` it ends its block: a branch that exits needs no `return` after it.
-- The status is taken mod 256, as in C.
def half (n : Int) : IO Int := do
  if n < 0 then
    IO.println "negative"
    IO.Process.exit 2
  else
    return n / 2

-- c: exit.c:17
def positive (n : Int) : IO Int := do
  if n <= 0 then
    IO.Process.exit 1
  return n

-- c: exit.c:22
def stop (code : Int) : IO Unit := do
  IO.println s!"stopping with {code}"
  IO.Process.exit (UInt8.ofNat ((code % 256).toNat))

