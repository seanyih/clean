def sum_file (path : String) : IO Int := do
  let src : IO.FS.Stream := (← fopen path "r")
  let mut a : Int := 0
  let mut b : Int := 0
  a ← scanInt src a
  b ← scanInt src b
  src.flush
  return a + b

