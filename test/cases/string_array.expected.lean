def insertionSort (arr : Array String) (n : Nat) : Array String := Id.run do
  let mut arr : Array String := arr
  for i in [1:n] do
    let mut j : Nat := i
    while j > 0 ∧ strcmp arr[j - 1]! arr[j]! > 0 do
      let t : String := arr[j - 1]!
      arr := arr.set! (j - 1) arr[j]!
      arr := arr.set! j t
      j := j - 1
  return arr

